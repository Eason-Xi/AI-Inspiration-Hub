# Default: local SQLite, no cloud credentials required.
STORAGE_BACKEND=local
# Optional. Configure here or in the Settings page.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Persistent local database and attachments (default: ./data)
# DATA_DIR=./data

# Vercel: set STORAGE_BACKEND=supabase and configure every value below.
# Keep these server-only. Never use NEXT_PUBLIC_ for secrets.
# Transaction pooler URI from Supabase Connect; URL-encode special password characters.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inspiration-hub
# Single-owner HTTP Basic access; use a randomly generated password (24+ characters).
APP_USERNAME=owner
APP_PASSWORD=
# 32+ random characters. Encrypts saved AI settings; keep stable across deployments.
APP_SECRET=
# 32+ random characters. Authorizes the daily recovery/temporary-file cleanup job.
CRON_SECRET=
